{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Haiyue Production Specialized Rendering Family v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "abiVersion", "passes"],
  "properties": {
    "format": { "const": "haiyue-production-specialized-rendering-family" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "abiVersion": { "const": 1 },
    "passes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "operation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
          "operation": {
            "enum": [
              "instanced-mesh3d",
              "line3d",
              "planar-mirror",
              "volume",
              "texture-convolution",
              "mipmap",
              "equirectangular-to-cube"
            ]
          }
        }
      }
    }
  }
}
