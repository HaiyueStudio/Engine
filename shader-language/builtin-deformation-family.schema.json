{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haiyue.dev/schema/builtin-deformation-family-v1.json",
  "title": "Haiyue Production Deformation Family v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "abiVersion", "passes"],
  "properties": {
    "format": { "const": "haiyue-production-deformation-family" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "abiVersion": { "const": 1 },
    "passes": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "operation"],
        "properties": {
          "id": { "type": "string" },
          "operation": {
            "enum": [
              "forward", "forward-skinned", "depth", "shadow", "shadow-morph",
              "shadow-skinned", "shadow-skinned-morph", "motion-vector", "outline"
            ]
          }
        }
      }
    }
  }
}
