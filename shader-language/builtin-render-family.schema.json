{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haiyue.dev/schema/builtin-render-family-v1.json",
  "title": "Haiyue builtin renderer module family",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "kind", "passes"],
  "properties": {
    "format": { "const": "haiyue-builtin-render-family" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "kind": { "enum": ["2d-ui", "simple-3d"] },
    "passes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "operation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
          "operation": {
            "enum": [
              "animation-2d", "bitmap-text", "canvas-text-2d", "gui-image",
              "gui-shape", "gui-text", "mesh2d", "particle2d", "radial-shadow",
              "spine2d", "tilemap2d", "basic-material", "basic-material-skinned",
              "mesh-helper", "normal-material", "particle3d", "sky"
            ]
          }
        }
      }
    }
  }
}
