{
  "format": "haiyue-ray-progressive-module-family",
  "version": 1,
  "id": "ray-progressive-sampling",
  "sequenceId": "haiyue-halton23-cranley-pcg32-v1",
  "accumulationFormat": "rgba16float",
  "passes": [
    {
      "id": "ray-progressive-accumulate", "source": "extensions/src/ray-tracing/sampling/shaders/progressive-accumulate.wgsl", "entryPoint": "accumulate_main", "logicalGroup": 3, "physicalGroup": 0,
      "bindings": [
        { "id": "progressive.params", "binding": 0, "kind": "buffer", "bufferType": "uniform", "minBindingSize": 64 },
        { "id": "progressive.rawSample", "binding": 1, "kind": "texture", "sampleType": "float", "viewDimension": "2d", "multisampled": false },
        { "id": "progressive.previousAccumulation", "binding": 2, "kind": "texture", "sampleType": "unfilterable-float", "viewDimension": "2d", "multisampled": false },
        { "id": "progressive.previousMoments", "binding": 3, "kind": "texture", "sampleType": "unfilterable-float", "viewDimension": "2d", "multisampled": false },
        { "id": "progressive.accumulationOutput", "binding": 4, "kind": "storage-texture", "access": "write-only", "format": "rgba16float", "viewDimension": "2d" },
        { "id": "progressive.momentsOutput", "binding": 5, "kind": "storage-texture", "access": "write-only", "format": "rgba16float", "viewDimension": "2d" },
        { "id": "progressive.featureOutput", "binding": 6, "kind": "storage-texture", "access": "write-only", "format": "rgba16float", "viewDimension": "2d" },
        { "id": "progressive.ageOutput", "binding": 7, "kind": "storage-texture", "access": "write-only", "format": "r32uint", "viewDimension": "2d" },
        { "id": "progressive.diagnostics", "binding": 8, "kind": "buffer", "bufferType": "storage", "minBindingSize": 16 }
      ]
    },
    {
      "id": "ray-progressive-present", "source": "extensions/src/ray-tracing/sampling/shaders/progressive-present.wgsl", "entryPoint": "present_main", "logicalGroup": 3, "physicalGroup": 0,
      "bindings": [
        { "id": "present.params", "binding": 0, "kind": "buffer", "bufferType": "uniform", "minBindingSize": 64 },
        { "id": "present.source", "binding": 1, "kind": "texture", "sampleType": "unfilterable-float", "viewDimension": "2d", "multisampled": false },
        { "id": "present.moments", "binding": 2, "kind": "texture", "sampleType": "unfilterable-float", "viewDimension": "2d", "multisampled": false },
        { "id": "present.feature", "binding": 3, "kind": "texture", "sampleType": "unfilterable-float", "viewDimension": "2d", "multisampled": false },
        { "id": "present.age", "binding": 4, "kind": "texture", "sampleType": "uint", "viewDimension": "2d", "multisampled": false },
        { "id": "present.output", "binding": 5, "kind": "storage-texture", "access": "write-only", "format": "rgba8unorm", "viewDimension": "2d" }
      ]
    }
  ]
