{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist-test",
    "declaration": false,
    "sourceMap": false,
    "paths": {
      "@haiyue/engine/*": ["../engine/dist/*.d.ts"],
      "@haiyue/engine": ["../engine/dist/index.d.ts"]
    },
    "typeRoots": [
      "../node_modules",
      "../node_modules/@types",
      "../engine/node_modules",
      "../engine/node_modules/@types"
    ],
    "types": ["@webgpu/types"]
  },
  "include": [
    "src/animation3d/runtime/state-machine/**/*.ts"
  ]
}
