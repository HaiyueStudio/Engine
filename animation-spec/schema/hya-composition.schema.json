{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haiyue.dev/schema/hya-composition-v1.json",
  "title": "HYA composition envelope v1",
  "description": "Editor shape aid. The source-neutral parser is normative for JSON safety, aggregate budgets, existing part formats, typed target addresses, dependencies and capability negotiation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "parts", "targets"],
  "properties": {
    "format": {"const": "haiyue-composition"},
    "version": {"const": 1},
    "parts": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/part"}},
    "targets": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/target"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f]+$"},
    "extension": {"type": "string", "maxLength": 256, "pattern": "^[a-zA-Z0-9]+(?:[.-][a-zA-Z0-9]+)+@[1-9][0-9]*$"},
    "part": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "extension", "required", "requires", "dependencies", "document"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "extension": {"$ref": "#/$defs/extension"},
        "required": {"type": "boolean"},
        "requires": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/extension"}},
        "dependencies": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "document": {}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "part", "kind", "address"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "part": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["animation-node", "layout-node", "text-block", "asset", "state-input", "interaction-target", "semantic-node", "audio-cue"]},
        "address": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
