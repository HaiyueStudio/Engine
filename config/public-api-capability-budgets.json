            "./checkbox": 3,
            "./context-menu": 4,
            "./dialog": 4,
            "./drawer": 5,
            "./dropdown": 5,
            "./history-controls": 3,
            "./input": 4,
            "./notification": 9,
            "./radio": 3,
            "./range": 5,
            "./select": 4,
            "./split": 4,
            "./tabs": 4,
            "./tooltip": 3,
            "./tree": 8,
            "./virtual-list": 8
          }
        }
      ]
    }
  }
}
