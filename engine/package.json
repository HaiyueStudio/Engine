      "import": "./dist/rtt.js"
    },
    "./font": {
      "source": "./src/font.ts",
      "types": "./dist/font.d.ts",
      "import": "./dist/font.js"
    },
    "./color": {
      "source": "./src/color.ts",
      "types": "./dist/color.d.ts",
      "import": "./dist/color.js"
    },
    "./lighting": {
      "source": "./src/lighting.ts",
      "types": "./dist/lighting.d.ts",
      "import": "./dist/lighting.js"
    },
    "./math": {
      "source": "./src/math.ts",
      "types": "./dist/math.d.ts",
      "import": "./dist/math.js"
    },
    "./serialization": {
      "source": "./src/serialization.ts",
      "types": "./dist/serialization.d.ts",
      "import": "./dist/serialization.js"
    },
    "./navigation": {
      "source": "./src/navigation.ts",
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js"
    }
  },
  "scripts": {
    "build": "node ../scripts/build-rollup-once.mjs",
    "dev": "rollup -c rollup.config.js --watch",
    "benchmark:wasm": "node ../scripts/build-rollup-once.mjs && node ../scripts/benchmark/m025-scene-batch-wasm.mjs",
    "test": "node ../scripts/build-rollup-once.mjs && node --test --test-concurrency=1 \"test/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@loaders.gl/schema": "^4.4.3",
    "@loaders.gl/worker-utils": "^4.4.3",
    "box2d.ts": "^1.0.2",
    "earcut": "^3.0.2",
    "pako": "^1.0.11",
    "wgpu-matrix": "^3.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@loaders.gl/textures": "^4.4.3",
    "@webgpu/types": "^0.1.40",
    "rollup": "^4.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.2.0"
  }
