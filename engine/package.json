      "source": "./src/compute.ts",
      "types": "./dist/compute.d.ts",
      "import": "./dist/compute.js"
    },
    "./scene": {
      "source": "./src/scene.ts",
      "types": "./dist/scene.d.ts",
      "import": "./dist/scene.js"
    },
    "./input": {
      "source": "./src/input.ts",
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./controls": {
