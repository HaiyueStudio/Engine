{
  "name": "@haiyue/engine",
  "version": "0.1.0",
  "private": false,
  "description": "A WebGPU-first 2D/3D game engine with PBR rendering, ECS, assets, animation, physics, and browser tooling.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaiyueStudio/Engine.git",
    "directory": "engine"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "src/**/*"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "source": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./assets": {
      "source": "./src/assets.ts",
      "types": "./dist/assets.d.ts",
      "import": "./dist/assets.js"
    },
    "./diagnostics": {
      "source": "./src/diagnostics.ts",
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js"
    },
    "./extension-authoring": {
      "source": "./src/extension-authoring.ts",
      "types": "./dist/extension-authoring.d.ts",
      "import": "./dist/extension-authoring.js"
    },
    "./ecs": {
      "source": "./src/ecs.ts",
      "types": "./dist/ecs.d.ts",
      "import": "./dist/ecs.js"
    },
    "./components": {
      "source": "./src/components.ts",
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./geometry": {
      "source": "./src/geometry.ts",
      "types": "./dist/geometry.d.ts",
      "import": "./dist/geometry.js"
    },
    "./material": {
      "source": "./src/material.ts",
      "types": "./dist/material.d.ts",
      "import": "./dist/material.js"
    },
    "./experimental": {
      "source": "./src/experimental.ts",
      "types": "./dist/experimental.d.ts",
      "import": "./dist/experimental.js"
    },
    "./experimental/assets": {
      "source": "./src/experimental/assets.ts",
      "types": "./dist/experimental/assets.d.ts",
      "import": "./dist/experimental/assets.js"
    },
    "./experimental/async": {
      "source": "./src/experimental/async.ts",
      "types": "./dist/experimental/async.d.ts",
      "import": "./dist/experimental/async.js"
    },
    "./experimental/ktx2-worker-runtime": {
      "source": "./src/experimental/ktx2-worker-runtime.ts",
      "types": "./dist/experimental/ktx2-worker-runtime.d.ts",
      "import": "./dist/experimental/ktx2-worker-runtime.js"
    },
    "./experimental/diagnostics": {
      "source": "./src/experimental/diagnostics.ts",
