        },
        {
          "id": "ignored-layer-obstacle-restores-route",
          "start": [1, 4, 1],
          "target": [5, 4, 1],
          "agentRadius": 0.1,
          "activeObstacleIds": ["upper-blocker"],
          "ignoreObstacleIds": ["upper-blocker"],
          "expected": {
            "status": "complete",
            "startRegion": "upper-left",
            "targetRegion": "upper-right",
            "regionPath": ["upper-left", "upper-right"],
            "portalPath": ["upper-door"],
            "blockedPortalIds": [],
            "obstacleRegions": {}
          }
        }
      ]
    }
  ]
}
