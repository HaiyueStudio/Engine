        },
        {
          "id": "ground-obstacle-blocks-ground-layer",
          "start": [1, 0, 1],
          "target": [5, 0, 1],
          "agentRadius": 0.1,
          "activeObstacleIds": ["ground-blocker"],
          "expected": {
            "status": "unreachable",
            "startRegion": "ground-left",
            "targetRegion": "ground-right",
            "regionPath": ["ground-left"],
            "portalPath": [],
            "blockedPortalIds": ["ground-door"],
            "obstacleRegions": { "ground-blocker": "ground-left" }
          }
        },
        {
          "id": "ground-obstacle-does-not-block-upper",
          "start": [1, 4, 1],
          "target": [5, 4, 1],
          "agentRadius": 0.1,
          "activeObstacleIds": ["ground-blocker"],
          "expected": {
            "status": "complete",
            "startRegion": "upper-left",
            "targetRegion": "upper-right",
            "regionPath": ["upper-left", "upper-right"],
            "portalPath": ["upper-door"],
            "blockedPortalIds": ["ground-door"],
            "obstacleRegions": { "ground-blocker": "ground-left" }
