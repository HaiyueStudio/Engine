{
  "schemaVersion": 1,
  "releaseId": "haiyue-0.2.3-gameplay",
  "releaseVersion": "0.2.3",
  "releaseMatrix": "config/release-matrix.json",
  "featureFreeze": {
    "status": "active",
    "classification": "capability-attributed-public-surface",
    "exceptions": "ADR 0139 / G01 frozen G02–G10 gameplay capabilities; G11 integration and qualification only"
  },
  "artifacts": [
    {
      "id": "engine-npm",
      "kind": "npm-package",
      "workspace": "engine",
      "packageName": "@haiyue/engine",
      "version": "0.2.3",
      "entry": ".",
      "supportTier": "stable",
      "owner": "engine",
      "verificationCommands": [
        "npm run api:check",
        "npm run verify:engine-package"
      ],
      "publishChannel": "npm-public-latest",
      "rollbackUnit": "npm:@haiyue/engine@0.2.3"
    },
    {
      "id": "animation-spec-npm",
      "kind": "npm-package",
      "workspace": "animation-spec",
      "packageName": "@haiyue/animation-spec",
      "version": "0.2.2",
      "entry": ".",
      "supportTier": "stable",
      "owner": "animation-spec",
      "verificationCommands": [
        "npm run api:check",
        "npm run verify:engine-package"
      ],
      "publishChannel": "npm-public-latest",
      "rollbackUnit": "npm:@haiyue/animation-spec@0.2.2"
    },
    {
      "id": "extensions-npm",
      "kind": "npm-package",
      "workspace": "extensions",
      "packageName": "@haiyue/extensions",
      "version": "0.2.3",
      "entry": "./animation",
      "supportTier": "stable-focused-subpaths",
      "owner": "extensions",
      "verificationCommands": [
        "npm run api:check",
        "npm run verify:engine-package"
      ],
      "publishChannel": "npm-public-latest",
      "rollbackUnit": "npm:@haiyue/extensions@0.2.3"
    },
    {
      "id": "shader-language-npm",
      "kind": "npm-package",
      "workspace": "shader-language",
      "packageName": "@haiyue/shader-language",
      "version": "0.2.3",
      "entry": ".",
      "supportTier": "stable-build-tooling",
      "owner": "shader-language",
      "verificationCommands": [
        "npm run api:check",
        "npm run verify:engine-package",
        "npm run shader-language:check"
      ],
      "publishChannel": "npm-public-latest",
      "rollbackUnit": "npm:@haiyue/shader-language@0.2.3"
    },
    {
      "id": "examples-static-catalog",
      "kind": "static-catalog",
      "workspace": "examples",
      "version": "0.2.3",
      "entry": "index.html",
      "supportTier": "supporting",
      "owner": "examples",
      "verificationCommands": [
        "npm run build:examples",
        "npm run examples:catalog:check"
      ],
      "publishChannel": "immutable-static-deployment",
      "rollbackUnit": "static:examples:0.2.3"
    }
  ],
  "packageVersions": {
    "@haiyue/engine": "0.2.3",
    "@haiyue/extensions": "0.2.3",
    "@haiyue/shader-language": "0.2.3",
    "@haiyue/animation-spec": "0.2.2"
  }
}
